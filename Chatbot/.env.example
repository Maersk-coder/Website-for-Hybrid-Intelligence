# Copy this file and name the copy ".env" (just .env, nothing before the dot).
# Then fill in your own values in .env.
# .env is never uploaded to GitHub, so your key stays secret. This example file is.

# Which AI writes the answers:
#   ollama    = free, runs on your own computer (needs the Ollama app, see README)
#   anthropic = Claude, paid per question, better answers (needs an API key)
# To switch, change this one line. See README: "Choosing the AI model".
LLM_PROVIDER=ollama

# --- Used when LLM_PROVIDER=ollama ---
# The model must be downloaded first with: ollama pull qwen3.5:4b
# Stronger but slower: qwen3.5:9b (see README for other options)
OLLAMA_MODEL=qwen3.5:4b
OLLAMA_URL=http://localhost:11434
# true = the model reasons step by step before answering (Qwen can, Gemma can't).
# Can give better answers, but each answer takes much longer.
OLLAMA_THINK=false

# --- The web server (api.py) ---
# The websites allowed to use the chatbot, separated by commas (no spaces, no / at the end).
# Now: VS Code's Live Server addresses, for testing. Later: your real domain, e.g. https://www.example.com
ALLOWED_ORIGINS=http://127.0.0.1:5500,http://localhost:5500

# --- Used when LLM_PROVIDER=anthropic ---
# Your Anthropic API key. Get one at https://console.anthropic.com (API Keys).
ANTHROPIC_API_KEY=your-key-goes-here
# Which Claude model writes the answers (claude-haiku-5-5 is the cheapest).
ANTHROPIC_MODEL=claude-opus-5-5
