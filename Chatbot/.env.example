# Copy this file and name the copy ".env" (just .env, nothing before the dot).
# Then change the values in .env if you want. .env is never uploaded to GitHub.
# After changing .env, restart the server (Ctrl+C, then python api.py).

# --- The AI model (Ollama, free, runs on your own computer) ---
# The model must be downloaded first with: ollama pull qwen3.5:4b
# Stronger but slower: qwen3.5:9b (see README)
OLLAMA_MODEL=qwen3.5:4b
OLLAMA_URL=http://localhost:11434
# true = the model reasons step by step before answering.
# Can give better answers, but each answer takes much longer.
OLLAMA_THINK=false

# --- The websites allowed to use the chatbot ---
# Separated by commas (no spaces, no / at the end).
# Now: the Django website on your own computer (python manage.py runserver 8001 in hi_website/).
# Later: the website's real address, e.g. https://www.example.com
ALLOWED_ORIGINS=http://127.0.0.1:8001,http://localhost:8001
