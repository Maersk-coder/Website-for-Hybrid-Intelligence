# Files in the Chatbot folder that Git should NOT upload to GitHub

# Your own settings
.env

# Made by the scripts: the search index (rebuilt with: python ingest.py)
# and data/preview.txt (made by: python ingest.py --preview)
data/

# The error log made by api.py
logs/

# The virtual environment (the installed packages). Recreate it with the README steps.
.venv/

# The research papers (copyright). Only the README in the folder is uploaded.
papers/*
!papers/README.md

# Python's own cache files
__pycache__/
*.pyc
