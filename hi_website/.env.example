# Copy this file and name the copy ".env" (just .env, nothing before the dot), in this same folder.
# Then fill in the values. .env is never uploaded to GitHub, so the password stays private.
# After changing .env, restart Django (Ctrl+C, then python manage.py runserver 8001).

# --- The email account the website sends from ---
# Leave these empty to save emails as files in sent_emails/ instead of sending them.
# For Gmail, the password is an "App password" (16 letters), NOT the normal Gmail password.
EMAIL_ADDRESS=
EMAIL_APP_PASSWORD=

# Only needed for another provider than Gmail:
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
